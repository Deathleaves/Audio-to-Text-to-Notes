# ============================================
# 隐私与安全 — 包含对话内容的文件不上传
# ============================================

# 音频文件（原始录音 + 预处理 WAV 片段）
# ⚠ 包含对话内容，属于隐私数据
audio/

# 输出文件（完整讲话记录 + 会议纪要）
# ⚠ 包含对话内容和提炼信息，属于隐私数据
output/

# 环境变量和密钥
.env
.env.local
.env.*.local
*.pem
*.key

# Claude Code 本地设置（可能包含 PAT token / API keys）
.claude/settings.local.json

# 项目原始需求文档
目标.md

# ============================================
# whisper.cpp — 模型文件大且可从源重新下载
# ============================================

whisper.cpp/
models/
ggml-*.bin

